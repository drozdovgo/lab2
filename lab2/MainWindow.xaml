<Window x:Class="lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="Gov" MouseEnter="MouseEnter_grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition />
            <RowDefinition Height="70"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>
        <InkCanvas x:Name="Paint"  Grid.Row="1" Margin="10">
            <InkCanvas.DefaultDrawingAttributes>
                <DrawingAttributes Color="Red" Height="10" Width="1"/>
            </InkCanvas.DefaultDrawingAttributes>
        </InkCanvas>

        <Menu Background="LightGray" BorderBrush="Navy" BorderThickness="1" Grid.Row="0" Padding="3">
            <MenuItem Header="_Меню">
                <MenuItem Header="_Сменить фон" Name="BackgroundColor" Click="MenueItem" MouseEnter="MouseEnter_grid" Tag="1"/>
                <MenuItem Header="_Информация" Click="Inf" Tag="3" MouseEnter="MouseEnter_grid"/>
                <Separator />
                <MenuItem Header="_Закрыть" Name="GOVExit" Click="Exit" Tag="2" MouseEnter="MouseEnter_grid" />
            </MenuItem>
            <MenuItem Header="_Редактор" >
                <MenuItem Header="_Сменить цвет" Name="Color" MouseEnter="MouseEnter_grid">
                    <ComboBox SelectedIndex="1" SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBoxItem Content="Красный" />
                        <ComboBoxItem Content="Чёрный"/>
                        <ComboBoxItem Content="Зелёный"/>
                        <ComboBoxItem Content="Синий"/>
                    </ComboBox>
                </MenuItem>
            </MenuItem>

        </Menu>

<!--Строка состояния, ВЕРНУТЬСЯ-->
        <StatusBar DockPanel.Dock="Bottom" Grid.Row="3" Background="LightGray">
            <TextBlock x:Name="Bar" />
        </StatusBar>
        
    </Grid>
</Window>
